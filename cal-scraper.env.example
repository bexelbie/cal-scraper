# Azure OpenAI translation service (optional — omit to produce Czech-only feeds)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=YOUR-API-KEY
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Fallback proxy (optional — retries failed requests through this proxy)
# FALLBACK_PROXY_URL=http://your-proxy.example.com:8888

# Base URL for webcal:// subscribe links in index.html (optional)
# CAL_BASE_URL=cal.example.com

# Fleet fact emission for monitoring controller (optional)
# FLEET_FACT_DIR=/var/spool/telegraf/facts
# FLEET_HOST=host-a
